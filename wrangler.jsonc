{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ccusageview",
  "compatibility_date": "2026-02-08",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "ai": {
    "binding": "AI",
  },
  "ratelimits": [
    {
      "name": "AI_SUGGEST_LIMIT",
      "namespace_id": "1892674301",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CCUSAGEVIEW_SHORT_URLS",
      "id": "91ef6e5f1def4ea8a5ceedc70e005ee7",
    },
  ],
}
